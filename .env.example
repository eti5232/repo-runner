# Copy this file to .env and fill in the values. Never share or submit .env.
# Keep this file ASCII-only: some tools read it with the Windows Hebrew code page.

# --- OpenAI ---
OPENAI_API_KEY=
# The model used for diagnosis and fixes
OPENAI_MODEL=gpt-5.4-mini

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=reporunner
